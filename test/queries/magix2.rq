prefix schema: <https://schema.org/>
prefix geo: <http://www.opengis.net/ont/geosparql#>

delete {
  graph ?g {
    ?s geo:asGeoJSON ?geojson .
  }
}
insert {
  graph ?g {
    ?s geo:hasGeometry [
      ?a geo:Geometry ;
      geo:asGeoJSON ?geojsonTyped
    ] .
  }
}
where {
  values ?g { <https://linked.data.gov.au/dataset/gswa/MAGIX/survey> }
  graph ?g {
    ?s geo:asGeoJSON ?geojson .
    BIND(STR(?geojson) AS ?geojsonStr)
    BIND(STRDT(?geojsonStr, geo:geoJSONLiteral) AS ?geojsonTyped)
  }
}
