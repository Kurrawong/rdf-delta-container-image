@prefix :          <urn:gswa:config#> .
@prefix dcat:      <http://www.w3.org/ns/dcat#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix delta:     <http://jena.apache.org/rdf-delta#> .
@prefix ex:        <https://example.org/> .
@prefix fuseki:    <http://jena.apache.org/fuseki#> .
@prefix geo:       <http://www.opengis.net/ont/geosparql#> .
@prefix geosparql: <http://jena.apache.org/geosparql#> .
@prefix gswa:      <https://linked.data.gov.au/dataset/gswa/> .
@prefix idx:       <urn:jena:lucene:index#> .
@prefix ja:        <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix bore:      <https://linked.data.gov.au/def/bore/> .
@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix sdo:       <https://schema.org/> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix tdb2:      <http://jena.apache.org/2016/tdb#> .
@prefix text:      <http://jena.apache.org/text#> .
@prefix time:      <http://www.w3.org/2006/time#> .
@prefix field:     <urn:jena:lucene:field#> .
@prefix schema:    <https://schema.org/> .
@prefix sosa:      <http://www.w3.org/ns/sosa/> .
@prefix geofh:     <https://linked.data.gov.au/def/geofh/> .
@prefix geosample: <https://linked.data.gov.au/def/geosample/> .
@prefix prof:      <http://www.w3.org/ns/dx/prof/> .
@prefix analyses:  <https://linked.data.gov.au/def/gswa-analyses/> .
@prefix po:  <http://www.essepuntato.it/2008/12/pattern#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .

:service
    rdf:type                           fuseki:Service ;
    fuseki:name                        "myds" ;
    fuseki:serviceQuery                "sparql" ;
    fuseki:serviceQuery                "query" ;
    fuseki:serviceUpdate               "update" ;
    fuseki:serviceUpload               "upload" ;
    fuseki:serviceReadWriteGraphStore  "data" ;
    fuseki:serviceReadGraphStore       "get" ;
    fuseki:dataset                     :delta_dataset ;
.	

:delta_dataset
    rdf:type                           delta:DeltaDataset ;
    delta:changes                      "http://delta:1066" ;
    delta:patchlog                     "myds";
    delta:zone                         "/fuseki/delta-zones";
    delta:storage                      "external";
    delta:dataset                      :geosparql_dataset ;
.
	
:geosparql_dataset
    rdf:type                            geosparql:geosparqlDataset ;
    geosparql:applyDefaultGeometry      false ;
    geosparql:indexEnabled              true ;
    geosparql:indexExpires              "5000,5000,5000" ;
    geosparql:indexSizes                "-1,-1,-1" ;
    geosparql:inference                 false ;
    geosparql:queryRewrite              true ;
    geosparql:spatialIndexFile          "/fuseki/databases/myds/spatial.index" ;
    geosparql:srsUri                    <http://www.opengis.net/def/crs/OGC/1.3/CRS84> ;
    geosparql:validateGeometryLiterals  false ;
    geosparql:dataset                   :text_dataset ;
    fuseki:dataset                     :text_dataset ;
.

:text_dataset
    rdf:type                           text:TextDataset ;
    text:dataset                       :tdb_dataset_readwrite ;
    text:indexes                       ( :shacl_index ) ;
.

:tdb_dataset_readwrite
    rdf:type                           tdb2:DatasetTDB2 ;
    tdb2:unionDefaultGraph             true ;
    ja:context [
      ja:cxtName "arq:queryTimeout" ;
      ja:cxtValue "30000,60000"
    ] ;
    tdb2:location                      "/fuseki/databases/myds" ;
.


# ===========================================================
# SHACL entity-per-document index (luc:query)
# ===========================================================
:shacl_index
    rdf:type          text:TextIndexShacl ;
    text:indexId      "shacl" ;
    text:directory    "/fuseki/databases/myds/lucene" ;
    text:shapes       (
        :ReportShape
        :BoreholeShape
        :BoreShape
        :DistributionShape
        :DrillholeShape
        :SurfaceSiteShape
        :SiteShape
        :GroupSiteShape
        :SurveyShape
        :SurveyDataShape
        :SurveyBlockShape
        :SchemaProjectShape
        :TitleShape
        :WellLogShape
        :TenementShape
       :FieldShape
       :FacilityShape
       :LoggingRunShape
       :ReprocessShape
       :ResourceEstimateShape
       :SeismicLineShape
       :CommodityShape
       :EventShape
       :ImageObjectShape
       :ObservationCollectionShape
       :BLTResourceShape
       :SampleShape
       :SurveyMethodShape
       :CommodityGroupShape
       # :ProductsShape
       :LithologyShape
       :PetrographyShape
       :StructureShape
       :SectholeShape
       :InterizonShape
       # :PrimaryMineralizationStyleShape
       :SecondaryMineralizationStyleShape
       # :MineralizationAttributeShape
       :ResourceShape
       # :CommentShape
       # :MiningDistrictsShape
       :MapSheetShape
       # :AdministrativeAreaShape
       # :DefinedRegionShape
       # :TectonicUnitShape
       :SiteClassificationShape
       :RegolithShape
       :GeochemistryAnalysisShape
       :ObservationShape
       :GeochronologyAnalysisShape
       :LuHfAnalysisShape
       :MetamorphicHistoryAnalysisShape
       :MineralChemistryAnalysisShape
       :OxygenAnalysisShape
       :SmNdAnalysisShape
       :ShrimpAnalysisShape
       :CorescanShape
       :DrillingSummaryShape
       :MetamorphicRecordShape
       :GeochronologyRecordShape
    ) ;
    text:storeValues  true ;
    text:maxFacetHits 50000 ;
    idx:fusekiBase    "http://localhost:3030" .

## --- Field definitions (canonical, path-free) ---
## Add TextFields to default search and KeywordFields to faceted/filter use.
## Sample-linked discovery is indexed on Sample documents to avoid
## materialising large child collections onto Drillhole or Borehole docs.

field:entityType
    idx:fieldName "entityType" ;
    idx:fieldType idx:KeywordField ;
    idx:facetable true ;
    idx:multiValued true ;
.

field:label
    idx:fieldName "label" ;
    idx:fieldType idx:TextField ;
    idx:multiValued true ;
    idx:defaultSearch true ;
.

field:identifier
    idx:fieldName "identifier" ;
    idx:fieldType idx:TextField ;
    idx:multiValued true ;
    idx:defaultSearch true;
    idx:analyzer [ rdf:type text:LowerCaseKeywordAnalyzer ] ;
    idx:queryAnalyzer [ rdf:type text:LowerCaseKeywordAnalyzer ] ;
.

field:identifierType
    idx:fieldName "identifierType" ;
    idx:fieldType idx:KeywordField ;
    idx:facetable true ;
    idx:multiValued true ;
.

field:identifierValueExact
