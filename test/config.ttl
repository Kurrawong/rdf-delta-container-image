## --- Entity shapes ---

:DistributionShape
    sh:targetClass dcat:Distribution ;
    sh:property [ idx:field field:entityType ; sh:path rdf:type ] ;
    sh:property [ idx:field field:label ; sh:path rdfs:label ] ;
    sh:property [ idx:field field:dataType ; sh:path gswa:hasDisplayTable ] ;
    sh:property [ idx:field field:sourceSystem ; sh:path gswa:sourceSystem ] ;
    sh:property [ idx:field field:name ; sh:path schema:name ] ;
    sh:property [ idx:field field:title ; sh:path dcterms:title ] ;
    sh:property [ idx:field field:dateCreated ; sh:path schema:dateCreated ] ;
    sh:property [ idx:field field:dateModified ; sh:path schema:dateModified ] ;
    sh:property [ idx:field field:datePublished ; sh:path schema:datePublished ] ;
    sh:property [ idx:field field:dateIssued ; sh:path dcterms:issued ] ;

.

:ReportShape
    sh:targetClass schema:Report ;
    sh:property [ idx:field field:entityType ; sh:path rdf:type ] ;
    sh:property [ idx:field field:label ; sh:path rdfs:label ] ;
    sh:property [ idx:field field:identifier ; sh:path ( schema:identifier schema:value ) ] ;
    idx:nested [
        idx:joinPath schema:identifier ;
        idx:property [ idx:field field:identifierType ; sh:path schema:propertyID ] ;
        idx:property [ idx:field field:identifierValueExact ; sh:path schema:value ] ;
        idx:property [ idx:field field:identifierValueText ; sh:path schema:value ] ;
        idx:facetHierarchy ( field:identifierType field:identifierValueExact ) ;
    ] ;
    sh:property [ idx:field field:geometry ; sh:path ( geo:hasGeometry geo:asWKT ) ] ;
    sh:property [ idx:field field:geometry ; sh:path ( bore:hasOriginPosition geo:asWKT ) ] ;
    sh:property [ idx:field field:geometry ; sh:path ( [ sh:inversePath schema:subjectOf ] [ sh:inversePath dcterms:hasPart ] bore:hasOriginPosition geo:asWKT ) ] ;
    sh:property [ idx:field field:status ; sh:path schema:status ] ;
    sh:property [ idx:field field:distribution ; sh:path dcat:distribution ] ;
    sh:property [ idx:field field:dateCreated ; sh:path schema:dateCreated ] ;
    sh:property [ idx:field field:dateModified ; sh:path schema:dateModified ] ;
    sh:property [ idx:field field:datePublished ; sh:path schema:datePublished ] ;
    sh:property [ idx:field field:dateIssued ; sh:path dcterms:issued ] ;
    sh:property [ idx:field field:endDate ; sh:path schema:endDate ] ;
    sh:property [ idx:field field:dataType ; sh:path gswa:hasDisplayTable ] ;
    sh:property [ idx:field field:sourceSystem ; sh:path gswa:sourceSystem ] ;
    sh:property [ idx:field field:title ; sh:path dcterms:title ] ;
    sh:property [ idx:field field:commodity ; sh:path gswa:hasTargetCommodity ] ;
    sh:property [ idx:field field:distributionName ; sh:path ( dcat:distribution schema:name ) ] ;
    # Benchmark cut 2026-05-05-2: inverse schema:about fan-in is expensive on reports.
    # sh:property [ idx:field field:aboutLabel ; sh:path ( [ sh:inversePath schema:about ] rdfs:label ) ] ;
    sh:property [ idx:field field:keywords ; sh:path dcat:keyword ] ;
    sh:property [ idx:field field:dataFormat ; sh:path ( dcat:resource dcat:distribution dcat:mediaType ) ] ;
    sh:property [ idx:field field:reportType ; sh:path schema:additionalType ] ;
    sh:property [ idx:field field:reportType ; sh:path dcterms:type ] ;
    sh:property [ idx:field field:relationshipTab ; sh:path [ sh:inversePath dcat:resource ] ] ;
    sh:property [ idx:field field:detailsParent ; sh:path [ sh:inversePath dcat:resource ] ; sh:class bore:Borehole ] ;
    sh:property [ idx:field field:detailsParent ; sh:path [ sh:inversePath schema:subjectOf ] ; sh:class schema:Project ] ;
    sh:property [ idx:field field:detailsParent ; sh:path [ sh:inversePath schema:subjectOf ] ; sh:class gswa:Survey ] ;
    sh:property [ idx:field field:detailsParent ; sh:path [ sh:inversePath schema:subjectOf ] ; sh:class gswa:Title ] ;
    sh:property [ idx:field field:releaseDate ; sh:path ( time:hasTime schema:value ) ] ;
    # Benchmark cut 2026-05-05-2: reportYear duplicates releaseDate's path and creates duplicate-value warnings.
    sh:property [ idx:field field:reportYear ; sh:path ( time:hasTime schema:value ) ] ;
    # Benchmark cut 2026-05-05-2: inverse schema:about fan-in from Tenement is high-cardinality.
    # sh:property [ idx:field field:tenement ; sh:path [ sh:inversePath schema:about ] ; sh:class gswa:Tenement ] ;
    sh:property [ idx:field field:title ; sh:path gswa:search_interface_description ] ;
    sh:property [ idx:field field:detailsParent ; sh:path [ sh:inversePath dcat:resource ] ; sh:class schema:Project ] ;
    sh:property [ idx:field field:boreholeFilter ; sh:path [ sh:inversePath schema:subjectOf ] ; sh:class bore:Borehole ] ;
    sh:property [ idx:field field:agentSearch ; sh:path ( prov:qualifiedAttribution prov:agent schema:name ) ] ;
    idx:nested [
        idx:joinPath prov:qualifiedAttribution ;
        idx:property [ idx:field field:attributionRole ; sh:path prov:hadRole ] ;
        idx:property [ idx:field field:agentName ; sh:path prov:agent ] ;
    ] ;
    sh:property [ idx:field field:project ; sh:path [ sh:inversePath dcat:resource ] ; sh:class schema:Project ] ;
    sh:property [ idx:field field:additionalType ; sh:path schema:additionalType ; sh:class gswa:SampleType ] ;
    sh:property [ idx:field field:tenement ; sh:path [ sh:inversePath schema:about ] ; sh:class gswa:Tenement ] ;
